# Copy to .env, then edit. These are shell assignments: quote spaces and special characters.
# Wi-Fi board setup (2.4 GHz); compiled into firmware when you flash it.
EPAPER_WIFI_SSID='Your Wi-Fi name'
EPAPER_WIFI_PASSWORD='Your Wi-Fi password'
# Generate your own key: python3 -c 'import secrets; print(secrets.token_hex(24))'
EPAPER_DEVICE_KEY='REPLACE_WITH_YOUR_GENERATED_KEY'
# Server runtime: leave unset for USB. Set after you find the board IP.
# EPAPER_DEVICE_HOST='192.168.1.50:7878'
EPAPER_HTTP_PORT=8787
# Weather/ticker settings are saved by the web app to this file.
EPAPER_CONFIG='data/dashboard.json'
